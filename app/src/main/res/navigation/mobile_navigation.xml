<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_welcome">

    <fragment
        android:id="@+id/nav_welcome"
        android:name="com.pl.donauturm.controller.ui.welcome.WelcomeFragment"
        android:label="@string/welcome_text"
        tools:layout="@layout/fragment_welcome" />

    <fragment
        android:id="@+id/nav_calendar"
        android:name="com.pl.donauturm.calendar.ui.calendar.MainFragmentCalendar"
        android:label="@string/menu_calendar"
        tools:layout="@layout/fragment_calendar" />

    <fragment
        android:id="@+id/nav_drinksmenu"
        android:name="com.pl.donauturm.drinksmenu.controller.drinkmenu.MainFragmentDrinksMenu"
        android:label="@string/menu_drinksmenu"
        tools:layout="@layout/fragment_drinks_menu" />

    <fragment
        android:id="@+id/nav_drinks"
        android:name="com.pl.donauturm.drinksmenu.controller.drinks.MainFragmentDrinks"
        android:label="@string/menu_drinks"
        tools:layout="@layout/fragment_drinks" />

    <fragment
        android:id="@+id/nav_pisignage"
        android:name="com.pl.donauturm.drinksmenu.controller.pisignage.MainFragmentPisignage"
        android:label="@string/menu_pisignage"
        tools:layout="@layout/fragment_pisignage" />

    <fragment
        android:id="@+id/nav_spotify"
        android:name="com.pl.donauturm.spotify.MainFragmentSpotify"
        android:label="@string/menu_spotify"
        tools:layout="@layout/fragment_main_spotify" />

    <fragment
        android:id="@+id/nav_bingo"
        android:name="com.pl.donauturm.bingo.MainFragmentBingo"
        android:label="@string/menu_bingo"
        tools:layout="@layout/fragment_bingo" />

    <fragment
        android:id="@+id/nav_checklist"
        android:name="com.pl.donauturm.checklist.MainFragmentChecklist"
        android:label="@string/menu_checklist"
        tools:layout="@layout/fragment_checklist" />

</navigation>